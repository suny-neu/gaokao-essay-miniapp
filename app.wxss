page {
  --bg: #f4f6fb;
  --surface: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e7ebf3;
  --track: #eef1f7;
  --accent: #4f46e5;
  --accent2: #7c3aed;
  --accent-hover: #4338ca;
  --accent-soft: rgba(79, 70, 229, 0.12);
  --good: #10b981;
  --good-soft: rgba(16, 185, 129, 0.12);
  --warn: #f59e0b;
  --warn-soft: #fef3c7;
  --bad: #ef4444;
  --bad-soft: #fee2e2;
  --radius: 36rpx;
  --radius-sm: 28rpx;
  --shadow: 0 2rpx 4rpx rgba(15, 23, 42, 0.04), 0 20rpx 44rpx rgba(15, 23, 42, 0.06);
  --shadow-sm: 0 2rpx 4rpx rgba(15, 23, 42, 0.04), 0 16rpx 36rpx rgba(15, 23, 42, 0.05);
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
}

page,
view,
text,
button,
navigator,
input,
textarea {
  box-sizing: border-box;
}

.num {
  font-variant-numeric: tabular-nums;
}

.essay-font {
  font-family: Georgia, "Times New Roman", serif;
}

.page {
  min-height: 100vh;
}

.page-scroll {
  min-height: 100vh;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 22rpx 20rpx 32rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.member-card,
.surface-card,
.history-card,
.runtime-card,
.manual-card,
.sheet-panel {
  background: rgba(255, 250, 244, 0.96);
  border: 1rpx solid rgba(212, 185, 165, 0.38);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(149, 116, 90, 0.08);
}

.hero-card,
.section-card,
.member-card,
.surface-card,
.runtime-card,
.manual-card {
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 28rpx 24rpx;
  background: radial-gradient(circle at top right, rgba(234, 199, 182, 0.56), transparent 34%),
    linear-gradient(160deg, #fff8f1 0%, #f9efe4 100%);
}

.support-card {
  background: linear-gradient(160deg, #fffaf4 0%, #fff3ea 100%);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(201, 122, 89, 0.14);
  color: #9d5e43;
  font-size: 21rpx;
  font-weight: 600;
}

.hero-title,
.section-title,
.card-title,
.content-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.18;
  margin-top: 14rpx;
}

.section-title,
.card-title,
.content-title {
  font-size: 28rpx;
  margin-top: 0;
  line-height: 1.3;
}

.hero-text,
.section-text,
.card-text,
.micro-text,
.empty-text,
.issue-text {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.72;
}

.section-head,
.row-between,
.meta-row,
.status-row,
.plan-row,
.history-row,
.runtime-row,
.manual-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.mode-stack,
.chip-row,
.tag-row,
.button-row,
.pill-row,
.filter-row,
.issue-list,
.diagnosis-grid,
.history-list,
.runtime-list,
.manual-list,
.status-list,
.plan-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mode-card,
.chip,
.filter-chip,
.tag,
.pill,
.runtime-pill {
  border-radius: 22rpx;
  box-sizing: border-box;
}

.mode-card {
  width: 100%;
  padding: 20rpx 22rpx;
  border: 2rpx solid rgba(212, 185, 165, 0.4);
  background: #fff9f3;
}

.mode-card.active {
  border-color: rgba(201, 122, 89, 0.88);
  box-shadow: 0 8rpx 20rpx rgba(201, 122, 89, 0.1);
}

.tone-coach {
  background: linear-gradient(135deg, #d7e7e3 0%, #edf5f2 100%);
}

.tone-generate {
  background: linear-gradient(135deg, #f4d9ca 0%, #fbefe6 100%);
}

.tone-grade {
  background: linear-gradient(135deg, #dbe7d1 0%, #eef4e8 100%);
}

.mode-label {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
}

.mode-desc,
.mode-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #66747a;
  line-height: 1.68;
}

.chip,
.filter-chip {
  padding: 12rpx 20rpx;
  border: 2rpx solid rgba(212, 185, 165, 0.55);
  background: rgba(255, 250, 244, 0.92);
  color: #4a5b61;
  font-size: 23rpx;
  line-height: 1.42;
}

.chip.active,
.filter-chip.active {
  background: rgba(201, 122, 89, 0.14);
  border-color: rgba(201, 122, 89, 0.88);
  color: #9d5e43;
  font-weight: 600;
}

.field-box {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  border: 2rpx solid rgba(228, 211, 198, 0.86);
  background: #fffdf9;
}

.field-box textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--text);
}

.field-box.compact textarea {
  min-height: 104rpx;
}

.mini-btn,
.primary-btn,
.secondary-btn,
.ghost-btn,
.tiny-btn {
  border-radius: 999rpx;
  font-size: 26rpx;
}

.mini-btn::after,
.primary-btn::after,
.secondary-btn::after,
.ghost-btn::after,
.tiny-btn::after {
  border: none;
}

.mini-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 54rpx;
  line-height: 54rpx;
  background: rgba(201, 122, 89, 0.1);
  color: #9d5e43;
  font-size: 24rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #c97858 0%, #d98e6b 100%);
  color: #fff;
}

.secondary-btn {
  background: #fff4eb;
  color: #9d5e43;
  border: 2rpx solid rgba(201, 122, 89, 0.28);
}

.ghost-btn {
  background: transparent;
  color: #866651;
  border: 2rpx solid rgba(212, 185, 165, 0.55);
}

.contact-btn {
  width: 100%;
}

.tiny-btn {
  margin: 0;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 18rpx;
  background: rgba(255, 244, 235, 0.95);
  color: #9d5e43;
  border: 2rpx solid rgba(201, 122, 89, 0.18);
  font-size: 22rpx;
}

.tag,
.pill,
.runtime-pill {
  padding: 9rpx 14rpx;
  background: rgba(201, 122, 89, 0.1);
  color: #8f593f;
  font-size: 21rpx;
}

.progress-line {
  margin-top: 16rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(214, 196, 182, 0.5);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #cc7b59 0%, #e2a480 100%);
}

.status-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(254, 250, 245, 0.98);
  border: 2rpx solid rgba(219, 197, 180, 0.72);
}

.status-item {
  width: 100%;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(242, 231, 220, 0.56);
}

.status-time {
  color: #9d5e43;
  font-size: 22rpx;
}

.preview-box {
  margin-top: 10rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #fffdf9;
  color: #25353c;
  font-size: 25rpx;
  line-height: 1.78;
  white-space: pre-wrap;
}

.meta-row,
.tag-row,
.button-row,
.filter-row,
.history-list,
.runtime-list,
.manual-list {
  margin-top: 16rpx;
}

.pill-row {
  margin-top: 16rpx;
}

.diagnosis-grid {
  margin-top: 16rpx;
}

.diagnosis-card {
  width: 100%;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 248, 240, 0.98);
  border: 2rpx solid rgba(229, 209, 193, 0.82);
  box-sizing: border-box;
}

.emphasis-card {
  background: linear-gradient(160deg, #fff9f3 0%, #fff3e8 100%);
}

.diagnosis-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #8c5f46;
}

.diagnosis-text {
  display: block;
  margin-top: 12rpx;
  color: #425359;
  font-size: 26rpx;
  line-height: 1.72;
}

.sentence-line {
  display: block;
  color: #425359;
  font-size: 25rpx;
  line-height: 1.84;
  margin-top: 12rpx;
  white-space: pre-wrap;
}

.sentence-line:first-child {
  margin-top: 0;
}

.content-box {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fffdf9;
  border: 2rpx solid rgba(232, 214, 202, 0.82);
}

.history-card,
.runtime-card,
.manual-card {
  width: 100%;
  padding: 22rpx;
  box-sizing: border-box;
}

.history-summary,
.runtime-detail {
  display: block;
  margin-top: 10rpx;
  color: #4e6168;
  font-size: 25rpx;
  line-height: 1.68;
}

.runtime-card.ready {
  border-color: rgba(150, 183, 143, 0.55);
  background: rgba(244, 249, 239, 0.98);
}

.runtime-card.warn {
  border-color: rgba(223, 177, 122, 0.48);
  background: rgba(255, 249, 240, 0.98);
}

.runtime-card.todo {
  border-color: rgba(214, 186, 166, 0.55);
}

.badge-ready,
.badge-warn,
.badge-todo {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.badge-ready {
  background: rgba(133, 176, 126, 0.18);
  color: #64895d;
}

.badge-warn {
  background: rgba(230, 189, 129, 0.22);
  color: #9c7641;
}

.badge-todo {
  background: rgba(201, 122, 89, 0.16);
  color: #9d5e43;
}

.empty-box {
  padding: 48rpx 28rpx;
  text-align: center;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(28, 34, 37, 0.28);
}

.sheet-panel {
  width: 100%;
  padding: 28rpx 24rpx 36rpx;
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
}

.plan-card {
  padding: 22rpx;
  border-radius: 22rpx;
  border: 2rpx solid rgba(218, 197, 182, 0.7);
  background: #fffdf8;
}

.plan-card-recommended {
  border-color: rgba(201, 122, 89, 0.68);
  background: linear-gradient(180deg, #fff9f1 0%, #fff4ea 100%);
}

.issue-list text {
  display: block;
}
