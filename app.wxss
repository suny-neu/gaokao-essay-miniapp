page {
  --bg: #F5F5F2;
  --surface: #FFFFFF;
  --surface-soft: #F7F8F5;
  --ink: #0A0B0A;
  --text: #171A18;
  --muted: #59615D;
  --border: #E4E7E2;
  --track: #E1E8E4;
  --accent: #12A875;
  --accent-text: #087A56;
  --accent2: #12A875;
  --accent-hover: #087A56;
  --accent-soft: #E8F7F0;
  --attention: #FF7A1A;
  --attention-soft: #FFF0E4;
  --good: #087A56;
  --good-soft: #E8F7F0;
  --warn: #8A4700;
  --warn-soft: #FFF1DF;
  --bad: #A83232;
  --bad-soft: #FCEAEA;
  --info: #28559B;
  --info-soft: #EAF1FB;
  --radius: 28rpx;
  --radius-sm: 20rpx;
  --shadow: 0 14rpx 34rpx rgba(26, 35, 30, 0.08);
  --shadow-sm: 0 6rpx 18rpx rgba(26, 35, 30, 0.055);
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
}

page,
view,
text,
button,
navigator,
input,
textarea {
  box-sizing: border-box;
}

.num {
  font-variant-numeric: tabular-nums;
}

.essay-font {
  font-family: Georgia, "Times New Roman", serif;
}

.page,
.page-scroll {
  min-height: 100vh;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 22rpx 20rpx 32rpx;
}

.hero-card,
.section-card,
.member-card,
.surface-card,
.history-card,
.runtime-card,
.manual-card,
.sheet-panel {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
}

.hero-card,
.section-card,
.member-card,
.surface-card,
.runtime-card,
.manual-card {
  padding: 24rpx;
}

.hero-card {
  padding: 28rpx 24rpx;
  background: linear-gradient(145deg, var(--accent-soft) 0%, var(--surface) 58%);
  box-shadow: var(--shadow-sm);
}

.support-card,
.emphasis-card,
.plan-card-recommended {
  background: var(--accent-soft);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-text);
  font-size: 21rpx;
  font-weight: 600;
}

.hero-title,
.section-title,
.card-title,
.content-title,
.section-heading {
  display: block;
  color: var(--text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.18;
  margin-top: 14rpx;
}

.section-title,
.card-title,
.content-title,
.section-heading {
  font-size: 28rpx;
  line-height: 1.3;
  margin-top: 0;
}

.hero-text,
.section-text,
.card-text,
.micro-text,
.empty-text,
.issue-text,
.page-purpose {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.72;
}

.page-purpose {
  margin-top: 8rpx;
}

.section-head,
.row-between,
.meta-row,
.status-row,
.plan-row,
.history-row,
.runtime-row,
.manual-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.mode-stack,
.chip-row,
.tag-row,
.button-row,
.pill-row,
.filter-row,
.issue-list,
.diagnosis-grid,
.history-list,
.runtime-list,
.manual-list,
.status-list,
.plan-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mode-card,
.chip,
.filter-chip,
.tag,
.pill,
.runtime-pill {
  border-radius: var(--radius-sm);
}

.mode-card {
  width: 100%;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--border);
  background: var(--surface);
}

.mode-card.active {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.tone-coach,
.tone-grade {
  background: var(--accent-soft);
}

.tone-generate {
  background: var(--info-soft);
}

.mode-label {
  display: block;
  color: var(--text);
  font-size: 27rpx;
  font-weight: 700;
}

.mode-desc,
.mode-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.68;
}

.chip,
.filter-chip {
  padding: 12rpx 20rpx;
  border: 2rpx solid var(--border);
  background: var(--surface);
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.42;
}

.chip.active,
.filter-chip.active {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent-text);
  font-weight: 600;
}

.field-box {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}

.field-box textarea {
  width: 100%;
  min-height: 180rpx;
  color: var(--text);
  font-size: 27rpx;
  line-height: 1.8;
}

.field-box.compact textarea {
  min-height: 104rpx;
}

.mini-btn,
.primary-btn,
.secondary-btn,
.ghost-btn,
.tiny-btn,
.text-btn,
.empty-action {
  margin: 0;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
}

.mini-btn::after,
.primary-btn::after,
.secondary-btn::after,
.ghost-btn::after,
.tiny-btn::after,
.text-btn::after,
.empty-action::after {
  border: none;
}

.primary-btn {
  color: #FFFFFF;
  background: var(--accent);
  box-shadow: 0 4rpx 10rpx rgba(23, 134, 107, 0.18);
}

.primary-btn[disabled] {
  background: var(--track);
  color: var(--muted);
  box-shadow: none;
}

.secondary-btn,
.ghost-btn {
  color: var(--accent-text);
  border: 2rpx solid var(--accent);
  background: var(--surface);
}

.mini-btn,
.tiny-btn,
.text-btn {
  padding: 0 12rpx;
  color: var(--accent-text);
  background: transparent;
}

.mini-btn,
.tiny-btn {
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
}

.contact-btn,
.empty-action {
  width: 100%;
}

.empty-action {
  margin-top: 20rpx;
  color: #FFFFFF;
  background: var(--accent);
}

.tag,
.pill,
.runtime-pill {
  padding: 9rpx 14rpx;
  color: var(--accent-text);
  background: var(--accent-soft);
  font-size: 21rpx;
}

.progress-line {
  margin-top: 16rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--track);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
}

.status-card {
  padding: 22rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}

.status-item {
  width: 100%;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
}

.status-time {
  color: var(--accent-text);
  font-size: 22rpx;
}

.preview-box,
.content-box {
  margin-top: 10rpx;
  padding: 16rpx;
  border: 2rpx solid var(--border);
  border-radius: 18rpx;
  background: var(--surface);
  color: var(--text);
  font-size: 25rpx;
  line-height: 1.78;
  white-space: pre-wrap;
}

.content-box {
  margin-top: 18rpx;
  padding: 22rpx;
}

.meta-row,
.tag-row,
.button-row,
.filter-row,
.history-list,
.runtime-list,
.manual-list,
.pill-row,
.diagnosis-grid {
  margin-top: 16rpx;
}

.diagnosis-card {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}

.diagnosis-label {
  display: block;
  color: var(--accent-text);
  font-size: 24rpx;
  font-weight: 700;
}

.diagnosis-text,
.sentence-line {
  display: block;
  margin-top: 12rpx;
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.72;
}

.sentence-line {
  font-size: 25rpx;
  line-height: 1.84;
  white-space: pre-wrap;
}

.sentence-line:first-child {
  margin-top: 0;
}

.history-card,
.runtime-card,
.manual-card {
  width: 100%;
  padding: 22rpx;
}

.history-summary,
.runtime-detail {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.68;
}

.runtime-card.ready {
  border-color: var(--good);
  background: var(--good-soft);
}

.runtime-card.warn {
  border-color: var(--warn);
  background: var(--warn-soft);
}

.runtime-card.todo {
  border-color: var(--border);
}

.badge-ready,
.badge-warn,
.badge-todo {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.badge-ready {
  color: var(--good);
  background: var(--good-soft);
}

.badge-warn {
  color: var(--warn);
  background: var(--warn-soft);
}

.badge-todo {
  color: var(--info);
  background: var(--info-soft);
}

.empty-box {
  padding: 48rpx 28rpx;
  text-align: center;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(23, 43, 37, 0.28);
}

.sheet-panel {
  width: 100%;
  padding: 28rpx 24rpx 36rpx;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: var(--shadow);
}

.plan-card {
  padding: 22rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}

.plan-card-recommended {
  border-color: var(--accent);
}

.issue-list text {
  display: block;
}
