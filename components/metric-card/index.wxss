.metric-card {
  min-height: 172rpx;
  padding: 26rpx 28rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.metric-value {
  display: inline-block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--text);
}

.metric-unit {
  margin-left: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--muted);
}

.metric-label {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--muted);
}

.metric-helper {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #94a3b8;
}
