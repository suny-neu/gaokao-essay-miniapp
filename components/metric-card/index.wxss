.metric-card {
  min-height: 172rpx;
  padding: 26rpx 28rpx;
  background: var(--surface, #FFFFFF);
  border: 2rpx solid var(--border, #DEEAE5);
  border-radius: var(--radius, 28rpx);
  box-shadow: var(--shadow-sm, none);
}

.metric-value {
  display: inline-block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--text, #172B25);
}

.metric-unit {
  margin-left: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--muted, #52665F);
}

.metric-label {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--muted, #52665F);
}

.metric-helper {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted, #52665F);
}
