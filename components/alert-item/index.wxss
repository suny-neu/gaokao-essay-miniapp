.alert-item {
  display: flex;
  overflow: hidden;
  background: var(--surface, #FFFFFF);
  border: 2rpx solid var(--border, #DEEAE5);
  border-radius: var(--radius, 28rpx);
  box-shadow: var(--shadow-sm, none);
}

.alert-accent {
  width: 8rpx;
  flex-shrink: 0;
}

.tone-amber .alert-accent {
  background: var(--warn, #8A4700);
}

.tone-violet .alert-accent,
.tone-info .alert-accent {
  background: var(--info, #28559B);
}

.alert-main {
  flex: 1;
  padding: 22rpx 24rpx;
}

.alert-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.alert-badge {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--warn, #8A4700);
}

.tone-violet .alert-badge,
.tone-info .alert-badge {
  background: var(--info, #28559B);
}

.alert-title {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text, #172B25);
}

.alert-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted, #52665F);
}
