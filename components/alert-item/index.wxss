.alert-item {
  display: flex;
  overflow: hidden;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.alert-accent {
  width: 8rpx;
  flex-shrink: 0;
}

.tone-amber .alert-accent {
  background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%);
}

.tone-violet .alert-accent {
  background: linear-gradient(180deg, #7c3aed 0%, #4f46e5 100%);
}

.alert-main {
  flex: 1;
  padding: 22rpx 24rpx;
}

.alert-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.alert-badge {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: #ffffff;
  background: #f59e0b;
}

.tone-violet .alert-badge {
  background: #7c3aed;
}

.alert-title {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text);
}

.alert-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted);
}
