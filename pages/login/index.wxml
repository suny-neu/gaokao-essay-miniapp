<view class="login-page">
  <view class="login-shell">
    <view class="brand">
      <view class="brand-logo">📘</view>
      <text class="brand-title">高考英语作文助手</text>
      <text class="brand-sub">微信登录后即可同步你的批改记录与会员权益</text>
    </view>

    <view class="auth-card surface-card">
      <block wx:if="{{!loggedIn}}">
        <text class="auth-title">微信一键登录</text>
        <text class="auth-desc">使用微信账号安全登录，不会获取你的昵称和头像。</text>
        <button class="wx-login-btn" loading="{{logging}}" bindtap="handleWechatLogin">
          <text class="wx-icon">微</text>微信一键登录
        </button>
        <text class="auth-tip">登录即表示同意《用户协议》与《隐私政策》</text>
      </block>

      <block wx:else>
        <view class="auth-state">
          <view class="state-dot"></view>
          <text class="state-text">已登录</text>
        </view>
        <view class="info-row">
          <text class="info-label">OpenID</text>
          <text class="info-value num">{{openId}}</text>
        </view>
        <view class="info-row" wx:if="{{userId}}">
          <text class="info-label">用户 ID</text>
          <text class="info-value num">{{userId}}</text>
        </view>
        <view class="info-row" wx:if="{{expiresAtText}}">
          <text class="info-label">登录有效期至</text>
          <text class="info-value num">{{expiresAtText}}</text>
        </view>
        <button class="logout-btn ghost-btn" bindtap="handleLogout">退出登录</button>
      </block>
    </view>
  </view>
</view>
