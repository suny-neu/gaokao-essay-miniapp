.login-page { min-height: 100vh; background: var(--bg); }.login-shell { padding: 52rpx 24rpx; }.brand { display: flex; flex-direction: column; align-items: center; margin-bottom: 32rpx; text-align: center; }.brand-logo { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; border-radius: var(--radius); background: var(--accent-soft); font-size: 56rpx; }.brand-title { display: block; margin-top: 18rpx; color: var(--text); font-size: 38rpx; font-weight: 700; }.auth-card, .membership-card { padding: 28rpx 24rpx; border: 1rpx solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-sm); }.auth-title, .membership-title, .step-title, .plan-name, .membership-state-title { display: block; color: var(--text); font-size: 30rpx; font-weight: 700; }.auth-desc, .auth-tip, .membership-desc, .step-desc, .plan-desc, .fair-use, .membership-error, .membership-state-text { display: block; margin-top: 10rpx; color: var(--muted); font-size: 23rpx; line-height: 1.65; }.wx-login-btn, .account-plans-btn { width: 100%; height: 88rpx; margin-top: 26rpx; line-height: 88rpx; }.account-plans-btn { margin-top: 22rpx; }.wx-icon { margin-right: 8rpx; }.auth-tip { text-align: center; }.auth-state, .info-row, .plan-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.state-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--good); }.state-text { flex: 1; color: var(--text); font-size: 28rpx; font-weight: 700; }.info-row { padding: 16rpx 0; border-top: 1rpx solid var(--border); }.info-label, .info-value { color: var(--muted); font-size: 23rpx; }.info-value { max-width: 430rpx; color: var(--text); text-align: right; word-break: break-all; }.logout-btn { width: 100%; height: 78rpx; margin-top: 16rpx; line-height: 78rpx; }.membership-card { margin-top: 22rpx; }.usage-step { display: flex; gap: 14rpx; margin-top: 20rpx; }.step-index { width: 34rpx; height: 34rpx; flex: none; border-radius: 50%; color: var(--accent-text); background: var(--accent-soft); font-size: 21rpx; line-height: 34rpx; text-align: center; }.membership-state { margin-top: 20rpx; padding: 18rpx; border-radius: var(--radius-sm); background: var(--accent-soft); }.plan-list { margin-top: 20rpx; }.plan-card { padding: 20rpx 0; border-top: 1rpx solid var(--border); }.plan-badge { padding: 4rpx 10rpx; border-radius: 999rpx; color: var(--accent-text); background: var(--accent-soft); font-size: 20rpx; }.plan-price { display: block; margin-top: 8rpx; color: var(--text); font-size: 31rpx; font-weight: 700; }.plan-btn { width: 100%; height: 72rpx; margin-top: 14rpx; border-radius: var(--radius-sm); color: #FFFFFF; background: var(--accent); font-size: 24rpx; line-height: 72rpx; }.plan-btn[disabled] { color: var(--muted); background: var(--track); }.membership-error { color: var(--bad); }
.danger-card { margin-top: 22rpx; padding: 24rpx; border: 1rpx solid #f0d2d2; border-radius: var(--radius); background: var(--surface); }
.danger-title { display: block; color: var(--text); font-size: 27rpx; font-weight: 700; }
.danger-desc { display: block; margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.delete-account-btn { width: 100%; height: 72rpx; margin-top: 12rpx; color: var(--bad); line-height: 72rpx; }
