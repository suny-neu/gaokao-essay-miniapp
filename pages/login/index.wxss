.login-page {
  min-height: 100vh;
  background: var(--bg);
}

.login-shell {
  padding: 60rpx 40rpx 48rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 44rpx;
}

.brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #c97858 0%, #d98e6b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: var(--shadow-sm);
}

.brand-title {
  margin-top: 22rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}

.brand-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted);
  max-width: 520rpx;
}

.auth-card {
  padding: 40rpx 32rpx;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.auth-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.auth-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--muted);
}

.wx-login-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
}

.wx-login-btn::after {
  border: none;
}

.wx-icon {
  font-weight: 700;
}

.auth-tip {
  display: block;
  margin-top: 22rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}

.auth-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.state-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--good);
}

.state-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 2rpx solid var(--border);
}

.info-label {
  font-size: 25rpx;
  color: var(--muted);
}

.info-value {
  font-size: 25rpx;
  color: var(--text);
  max-width: 420rpx;
  text-align: right;
  word-break: break-all;
}

.logout-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
}
