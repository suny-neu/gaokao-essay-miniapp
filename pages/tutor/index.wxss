.tutor-page { min-height: 100vh; background: var(--bg); }.tutor-shell { display: flex; flex-direction: column; min-height: 100vh; padding: 28rpx 24rpx 40rpx; }.page-intro { margin-bottom: 20rpx; }.chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }.type-row { margin-bottom: 14rpx; }.type-row .chip { flex: 1; text-align: center; }.chip { padding: 11rpx 18rpx; border: 2rpx solid var(--border); border-radius: 999rpx; color: var(--muted); background: var(--surface); font-size: 23rpx; }.chip-on { color: #FFFFFF; border-color: var(--accent); background: var(--accent); }.mode-guide { margin-top: 18rpx; padding: 18rpx; border: 2rpx solid var(--border); border-radius: var(--radius-sm); background: var(--accent-soft); }.guide-row { display: flex; gap: 16rpx; line-height: 1.55; }.guide-row + .guide-row { margin-top: 10rpx; }.guide-label { flex: none; color: var(--accent-text); font-size: 22rpx; font-weight: 700; }.guide-text { color: var(--text); font-size: 22rpx; }.tutor-mode-row { margin-top: 16rpx; }.tutor-mode-choice { flex: 1; min-width: 260rpx; }.tutor-mode-description { display: block; margin-top: 4rpx; font-size: 20rpx; }.chat-stack { flex: 1; display: flex; flex-direction: column; gap: 16rpx; min-height: 440rpx; margin-top: 22rpx; }.chat-row { display: flex; }.chat-row-me { justify-content: flex-end; }.bubble { max-width: 84%; padding: 18rpx 22rpx; border-radius: 26rpx; font-size: 26rpx; line-height: 1.6; }.bubble-ai { color: var(--text); border: 2rpx solid var(--border); background: var(--surface); }.bubble-me { color: #FFFFFF; background: var(--accent); }.ai-text { color: var(--text); }.chip-row-bottom { margin-top: 14rpx; }.inputbar { display: flex; align-items: center; gap: 10rpx; margin-top: 18rpx; padding: 10rpx 10rpx 10rpx 20rpx; border: 2rpx solid var(--border); border-radius: var(--radius); background: var(--surface); }.chat-input { flex: 1; min-width: 0; min-height: 72rpx; padding: 14rpx 0; color: var(--text); font-size: 26rpx; line-height: 1.5; }.chat-input.ghost { color: var(--muted); }.send-btn { width: 102rpx; height: 72rpx; margin: 0; padding: 0; border-radius: var(--radius-sm); font-size: 24rpx; line-height: 72rpx; }
