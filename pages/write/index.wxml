<view class="write-page">
  <view class="write-shell">
    <view class="page-intro">
      <text class="section-heading">写一篇，再拿到可执行的修改建议</text>
      <text class="page-purpose">按题目写作，拍照也能录入；提交后会告诉你先改哪里。</text>
    </view>
    <view class="write-steps" aria-label="写作四步">
      <text class="step-chip">1 选题型</text><text class="step-chip">2 录入题目</text><text class="step-chip">3 写作文</text><text class="step-chip">4 提交批改</text>
    </view>
    <view class="type-switch">
      <view class="type-chip {{essayType === 'application' ? 'type-chip-on' : ''}}" data-type="application" bindtap="chooseEssayType">应用文</view>
      <view class="type-chip {{essayType === 'continuation' ? 'type-chip-on' : ''}}" data-type="continuation" bindtap="chooseEssayType">读后续写</view>
    </view>

    <panel-card wx:if="{{essayType === 'application'}}" extraClass="topic-card">
      <view class="section-head">
        <view>
          <view class="tag tag-type">{{taskTag}}</view>
          <text class="field-label section-label">题目材料</text>
        </view>
        <button
          class="section-action question-ocr-action"
          loading="{{questionOcrLoading}}"
          disabled="{{questionOcrLoading || ocrLoading || loading}}"
          bindtap="chooseQuestionImageAndOcr"
        >拍照识题</button>
      </view>
      <textarea
        class="topic-input essay-font"
        value="{{promptText}}"
        bindinput="handlePromptInput"
        auto-height
        maxlength="-1"
        placeholder="请输入或粘贴作文题目"
      ></textarea>
      <view class="req-row">
        <text wx:for="{{requirements}}" wx:key="*this" class="req-item">• {{item}}</text>
      </view>
    </panel-card>

    <panel-card wx:if="{{essayType === 'continuation'}}" extraClass="topic-card continuation-question-card">
      <view class="question-card-head">
        <view>
          <view class="tag tag-type">{{taskTag}}</view>
          <text class="field-label">题目材料</text>
        </view>
        <view class="question-actions">
          <button
            class="section-action question-ocr-action"
            loading="{{questionOcrLoading}}"
            disabled="{{questionOcrLoading || ocrLoading || loading}}"
            bindtap="chooseQuestionImageAndOcr"
          >拍照识题</button>
          <button
            wx:if="{{!editingContinuationQuestion}}"
            class="text-action"
            bindtap="startEditingContinuationQuestion"
          >编辑</button>
        </view>
      </view>

      <view wx:if="{{editingContinuationQuestion}}">
        <textarea
          class="source-input essay-font"
          value="{{sourceMaterial}}"
          bindinput="handleSourceMaterialInput"
          maxlength="-1"
          placeholder="请粘贴读后续写原文，或拍照识别题目"
        ></textarea>

        <view class="starter-edit-block">
          <text class="given-label">题目已给 · 第一段首句</text>
          <textarea
            class="starter-input essay-font"
            value="{{paragraphOneStarter}}"
            bindinput="handleParagraphOneInput"
            auto-height
            maxlength="-1"
            placeholder="Paragraph 1:"
          ></textarea>
        </view>

        <view class="starter-edit-block">
          <text class="given-label">题目已给 · 第二段首句</text>
          <textarea
            class="starter-input essay-font"
            value="{{paragraphTwoStarter}}"
            bindinput="handleParagraphTwoInput"
            auto-height
            maxlength="-1"
            placeholder="Paragraph 2:"
          ></textarea>
        </view>

        <button class="text-action complete-question-action" bindtap="finishEditingContinuationQuestion">完成题目录入</button>
      </view>

      <view wx:else class="question-preview">
        <text class="question-source essay-font">{{sourceMaterial}}</text>
        <view class="given-sentence">
          <text class="given-label">题目已给 · 第一段首句</text>
          <text class="essay-font">{{paragraphOneStarter}}</text>
        </view>
        <view class="given-sentence">
          <text class="given-label">题目已给 · 第二段首句</text>
          <text class="essay-font">{{paragraphTwoStarter}}</text>
        </view>
        <text class="question-note">续写时请承接首句，不要重复抄写首句</text>
      </view>

      <view class="req-row">
        <text wx:for="{{requirements}}" wx:key="*this" class="req-item">• {{item}}</text>
      </view>
    </panel-card>

    <view class="word-count">
      <view class="word-count-top">
        <text class="word-count-label">已写词数</text>
        <text class="word-count-value"><text class="num strong">{{wordCount}}</text> / {{targetWordCount}}</text>
      </view>
      <view class="bar">
        <view class="bar-fill" style="width: {{wordCountPercent}}%;"></view>
      </view>
    </view>

    <view class="draft-head">
      <text class="field-label draft-label">{{essayType === 'continuation' ? '我的续写' : '我的作文'}}</text>
      <button
        class="section-action draft-ocr-action"
        loading="{{ocrLoading}}"
        disabled="{{ocrLoading || questionOcrLoading || loading}}"
        bindtap="chooseImageAndOcr"
      >拍照录入</button>
    </view>

    <panel-card extraClass="draft-card">
      <textarea
        class="draft-input essay-font"
        value="{{draftText}}"
        bindinput="handleDraftInput"
        maxlength="-1"
        placeholder="{{essayType === 'continuation' ? '请输入或粘贴你的两段续写' : '请输入或粘贴你的作文'}}"
      ></textarea>
    </panel-card>

    <view wx:if="{{essayType === 'application'}}" class="hint-box">
      <text class="hint-icon">💡</text>
      <text class="hint-text">建议用 <text class="hint-strong">“{{aiHint.to}}”</text> 替换 <text class="hint-from">“{{aiHint.from}}”</text>，更正式。</text>
    </view>

    <view wx:if="{{submitStatus}}" class="submit-status">
      <text class="submit-status-text">{{submitStatus}}</text>
    </view>

    <view class="action-stack initial-action">
      <button class="primary-btn write-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="goFormalEditor">提交批改</button>
      <button class="text-action tutor-link" bindtap="goTutor">暂时不会写？先去 AI 陪练</button>
    </view>
  </view>
</view>
