.write-page {
  min-height: 100vh;
  background: var(--bg);
}

.write-shell {
  padding: 24rpx 36rpx 52rpx;
}

.type-switch {
  display: flex;
  gap: 14rpx;
}
.topic-input {
  width: 100%;
  min-height: 150rpx;
  box-sizing: border-box;
  padding: 16rpx 0;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.7;
}

.question-ocr-btn {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 700;
}

.source-input {
  width: 100%;
  min-height: 300rpx;
  box-sizing: border-box;
  padding: 16rpx 0;
  color: var(--text);
  font-size: 27rpx;
  line-height: 1.7;
}

.starter-input {
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
  color: var(--text);
  font-size: 27rpx;
  line-height: 1.6;
}

.draft-label {
  margin-top: 24rpx;
}
.type-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  background: var(--surface);
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
}

.type-chip-on {
  color: #fff;
  border-color: transparent;
  background: var(--accent);
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.25);
}

.topic-card {
  padding: 28rpx;
}

.question-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.text-action {
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: rgba(79, 70, 229, 0.08);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.text-action::after {
  border: none;
}

.starter-edit-block,
.given-sentence {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-sm);
  background: rgba(79, 70, 229, 0.06);
}

.given-label {
  display: block;
  margin-bottom: 10rpx;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 700;
}

.complete-question-action {
  margin: 0 auto;
}

.question-preview {
  color: var(--text);
  font-size: 27rpx;
  line-height: 1.7;
}

.question-source {
  display: block;
  white-space: pre-wrap;
}

.given-sentence .essay-font {
  display: block;
}

.question-note {
  display: block;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.tag-type {
  color: #3730a3;
  background: rgba(79, 70, 229, 0.12);
}

.topic-text {
  display: block;
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text);
}

.req-row {
  display: flex;
  gap: 28rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.req-item {
  font-size: 23rpx;
  color: var(--muted);
}

.word-count {
  margin-top: 24rpx;
}

.word-count-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.word-count-label,
.word-count-value {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--muted);
}

.strong {
  color: var(--accent);
  font-size: 30rpx;
}

.bar {
  height: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--track);
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
}

.draft-card {
  margin-top: 24rpx;
  padding: 0;
}

.draft-input {
  width: 100%;
  min-height: 360rpx;
  padding: 28rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: #312e4e;
}

.hint-box {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid rgba(79, 70, 229, 0.2);
  background: rgba(79, 70, 229, 0.08);
}

.hint-icon {
  font-size: 24rpx;
}

.hint-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.55;
  color: #3730a3;
}

.hint-strong {
  color: #4338ca;
  font-weight: 700;
}

.hint-from {
  color: #6366f1;
  text-decoration: line-through;
}

.submit-status {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border);
  background: rgba(255, 255, 255, 0.72);
}

.submit-status-text {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--muted);
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.write-btn {
  height: 92rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
}

.write-btn::after {
  border: none;
}

.write-btn-primary {
  color: #fff;
  background: var(--accent);
  box-shadow: 0 16rpx 36rpx rgba(79, 70, 229, 0.28);
}

.write-btn-secondary {
  color: var(--text);
  border: 2rpx solid var(--border);
  background: var(--surface);
}

.ocr-btn {
  margin-top: 24rpx;
}
