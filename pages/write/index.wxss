.write-page {
  min-height: 100vh;
  background: var(--bg);
}

.write-shell {
  padding: 22rpx 24rpx 56rpx;
}

.page-intro {
  margin-bottom: 14rpx;
}

.write-steps,
.type-switch,
.req-row,
.section-head,
.question-card-head,
.question-actions,
.draft-head,
.word-count-top {
  display: flex;
  align-items: center;
}

.write-steps,
.type-switch,
.req-row {
  flex-wrap: wrap;
  gap: 10rpx;
}

.write-steps {
  margin-bottom: 16rpx;
  overflow: hidden;
  flex-wrap: nowrap;
}

.step-chip,
.tag,
.req-item {
  padding: 6rpx 11rpx;
  border-radius: 999rpx;
  color: var(--accent-text);
  background: var(--accent-soft);
  font-size: 19rpx;
  white-space: nowrap;
}

.type-switch {
  margin-bottom: 14rpx;
}

.type-chip {
  flex: 1;
  padding: 13rpx;
  border: 2rpx solid var(--border);
  border-radius: 18rpx;
  text-align: center;
  color: var(--muted);
  background: var(--surface);
  font-size: 24rpx;
}

.type-chip-on {
  color: #FFFFFF;
  border-color: var(--accent);
  background: var(--accent);
}

.topic-card,
.draft-card {
  margin-top: 14rpx;
  padding: 20rpx;
}

.section-head,
.question-card-head,
.draft-head,
.word-count-top {
  justify-content: space-between;
  gap: 16rpx;
}

.question-actions {
  flex: none;
  gap: 8rpx;
}

.topic-input,
.source-input,
.starter-input,
.draft-input {
  width: 100%;
  box-sizing: border-box;
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.65;
}

.topic-input {
  min-height: 104rpx;
  padding: 8rpx 0;
}

.source-input {
  min-height: 180rpx;
  max-height: 300rpx;
  padding: 12rpx 0;
}

.starter-input {
  min-height: 64rpx;
}

.draft-card {
  padding: 0;
}

.draft-input {
  min-height: 360rpx;
  padding: 24rpx;
}

.field-label,
.given-label {
  display: block;
  margin: 14rpx 0 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 600;
}

.section-label,
.draft-label {
  margin-bottom: 0;
}

.given-label {
  margin-top: 0;
  color: var(--accent-text);
}

.section-action,
.text-action {
  min-height: 54rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 999rpx;
  color: var(--accent-text);
  background: var(--accent-soft);
  font-size: 20rpx;
  line-height: 54rpx;
}

.section-action[disabled] {
  color: var(--muted);
  background: var(--surface-soft);
}

.starter-edit-block,
.given-sentence {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
}

.complete-question-action {
  width: 100%;
  margin-top: 12rpx;
}

.question-preview,
.question-source {
  display: block;
  color: var(--text);
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.question-preview {
  max-height: 360rpx;
  overflow: hidden;
}

.question-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.req-row {
  margin-top: 12rpx;
}

.word-count {
  margin-top: 18rpx;
}

.word-count-label,
.word-count-value {
  color: var(--muted);
  font-size: 22rpx;
}

.strong {
  color: var(--accent);
  font-size: 28rpx;
}

.bar {
  height: 10rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--track);
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
}

.draft-head {
  margin-top: 16rpx;
}

.hint-box,
.submit-status {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  background: var(--surface-soft);
}

.hint-text,
.submit-status-text {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.hint-strong {
  color: var(--accent-text);
  font-weight: 700;
}

.hint-from {
  text-decoration: line-through;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 24rpx;
}

.write-btn {
  width: 100%;
  height: 82rpx;
  margin: 0;
  border-radius: 20rpx;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 82rpx;
}

.write-btn-secondary {
  color: var(--accent-text);
  border: 2rpx solid var(--accent);
  background: var(--surface);
}

.tutor-link {
  width: 100%;
  color: var(--muted);
  background: transparent;
}
