.report-page {
  min-height: 100vh;
  background: var(--bg);
}

.report-shell {
  padding: 24rpx 36rpx 52rpx;
}

.summary-card,
.list-card,
.empty-card {
  padding: 28rpx;
}

.summary-head,
.section-head,
.error-item,
.highlight-item,
.action-row,
.dim-row {
  display: flex;
  align-items: center;
}

.summary-head {
  justify-content: space-between;
}

.summary-label {
  font-size: 23rpx;
  color: var(--muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-weight: 600;
}

.summary-delta {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--good);
  background: rgba(16, 185, 129, 0.13);
}

.summary-score-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 16rpx;
}

.summary-score {
  font-size: 84rpx;
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.03em;
  color: var(--text);
}

.summary-suffix {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--muted);
}

.dim-list {
  margin-top: 24rpx;
}

.dim-row {
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.dim-row:last-child {
  margin-bottom: 0;
}

.dim-label {
  width: 76rpx;
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 600;
}

.dim-bar {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--track);
}

.dim-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
}

.weak .dim-fill {
  background: linear-gradient(90deg, #fbbf24, #f59e0b);
}

.dim-score {
  width: 92rpx;
  text-align: right;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--text);
}

.section-head {
  justify-content: space-between;
  margin: 32rpx 4rpx 18rpx;
}

.section-name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
}

.section-count {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--accent);
  background: rgba(79, 70, 229, 0.12);
}

.error-item,
.highlight-item {
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--track);
}

.error-item:last-child,
.highlight-item:last-child {
  border-bottom: none;
}

.tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.tag-err {
  color: #991b1b;
  background: #fee2e2;
}

.tag-good {
  color: #065f46;
  background: rgba(16, 185, 129, 0.13);
}

.error-body,
.highlight-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.55;
}

.error-body {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.error-from {
  color: var(--bad);
  text-decoration: line-through;
}

.error-arrow {
  color: var(--muted);
}

.error-to {
  color: var(--good);
  font-weight: 700;
}

.action-row {
  gap: 16rpx;
  margin-top: 32rpx;
}

.report-btn {
  flex: 1;
  height: 92rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
}

.report-btn::after {
  border: none;
}

.report-btn-primary {
  color: #fff;
  background: var(--accent);
  box-shadow: 0 16rpx 36rpx rgba(79, 70, 229, 0.28);
}

.report-btn-secondary {
  color: var(--text);
  border: 2rpx solid var(--border);
  background: var(--surface);
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.empty-text {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted);
}

.solo-btn {
  margin-top: 28rpx;
}
