.report-page { min-height: 100vh; background: var(--bg); }.report-intro, .report-shell { padding: 28rpx 24rpx 0; }.report-shell { padding-bottom: 56rpx; }.summary-card, .list-card, .empty-card { padding: 24rpx; }.summary-head, .section-head, .dim-row, .error-item, .action-row { display: flex; align-items: center; gap: 14rpx; }.summary-head, .section-head { justify-content: space-between; }.summary-label, .section-subtitle, .empty-section, .error-label, .error-reason, .legacy-notice, .empty-text { color: var(--muted); font-size: 22rpx; line-height: 1.55; }.summary-score-row { display: flex; align-items: baseline; gap: 8rpx; margin-top: 12rpx; }.summary-score { color: var(--text); font-size: 82rpx; font-weight: 800; line-height: 1; }.summary-suffix { color: var(--muted); font-size: 28rpx; }.dim-list { margin-top: 22rpx; }.dim-row { margin-top: 14rpx; }.dim-label { width: 76rpx; color: var(--muted); font-size: 23rpx; }.dim-bar { flex: 1; height: 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--track); }.dim-fill { height: 100%; border-radius: inherit; background: var(--accent); }.weak .dim-fill { background: var(--warn); }.dim-score { width: 90rpx; color: var(--text); font-size: 22rpx; text-align: right; }.section-head { margin: 30rpx 4rpx 14rpx; }.section-name, .empty-title { display: block; color: var(--text); font-size: 27rpx; font-weight: 700; }.section-count, .tag { padding: 5rpx 12rpx; border-radius: 999rpx; color: var(--accent-text); background: var(--accent-soft); font-size: 21rpx; }.section-count-upgrade, .tag-upgrade { color: var(--info); background: var(--info-soft); }.tag-err { color: var(--bad); background: var(--bad-soft); }.coach-block, .error-item { padding: 18rpx 0; border-bottom: 1rpx solid var(--border); }.coach-block:last-child, .error-item:last-child { border-bottom: 0; }.coach-label { display: block; margin-bottom: 6rpx; color: var(--accent-text); font-size: 22rpx; font-weight: 700; }.coach-text, .priority-text, .next-practice-text, .improved-essay { display: block; color: var(--text); font-size: 25rpx; line-height: 1.7; white-space: pre-wrap; }.error-item { align-items: flex-start; }.error-body { flex: 1; display: flex; flex-direction: column; gap: 8rpx; min-width: 0; font-size: 24rpx; }.error-from.real-error { color: var(--bad); text-decoration: line-through; }.error-to { color: var(--good); font-weight: 700; }.upgrade-to { color: var(--info); font-weight: 700; }.priority-card, .next-practice-card { background: var(--accent-soft); }.legacy-notice { margin-top: 16rpx; padding: 14rpx; border-radius: var(--radius-sm); color: var(--warn); background: var(--warn-soft); }.action-row { margin-top: 30rpx; }.report-btn { flex: 1; height: 88rpx; margin: 0; border-radius: var(--radius-sm); font-size: 26rpx; line-height: 88rpx; }.report-btn-secondary { color: var(--accent-text); border: 2rpx solid var(--accent); background: var(--surface); }.solo-btn { width: 100%; margin-top: 24rpx; }.empty-title { font-size: 30rpx; }

.model-essay-entry-card {
  padding: 30rpx 28rpx;
}

.content-advice-card {
  background: var(--accent-soft);
}

.content-advice-text {
  display: block;
  color: var(--text);
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.model-essay-entry-title {
  display: block;
  color: var(--text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.model-essay-entry-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.65;
}

.model-essay-generate {
  width: 78%;
  height: 76rpx;
  margin: 24rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
  background: var(--ink);
}

.model-essay-generate::after {
  border: 0;
}
