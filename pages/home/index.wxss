.dashboard-page {
  min-height: 100vh;
  background: var(--bg);
}

.dashboard-scroll {
  min-height: 100vh;
}

.dashboard-shell {
  padding: 24rpx 36rpx 52rpx;
}

.dashboard-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0 24rpx;
}

.dashboard-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text);
}

.dashboard-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted);
}

.countdown-box {
  text-align: right;
}

.countdown-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--accent);
}

.countdown-unit {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.hero-card {
  padding: 32rpx;
}

.micro-heading {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
}

.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20rpx;
  margin-top: 16rpx;
}

.hero-score {
  display: flex;
  align-items: flex-end;
}

.hero-big {
  font-size: 92rpx;
  font-weight: 800;
  line-height: 0.9;
  letter-spacing: -0.03em;
  color: var(--text);
}

.hero-of {
  margin-left: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--muted);
}

.hero-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.hero-delta {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--good);
  background: var(--good-soft);
}

.hero-topic {
  max-width: 280rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
  text-align: right;
}

.hero-bar {
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--track);
}

.hero-bar-fill {
  width: 84%;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.section-title {
  display: block;
  margin: 36rpx 4rpx 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
}

.section-title-first {
  margin-top: 8rpx;
}

.daily-task-card {
  padding: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f2f0ff 100%);
  border: 2rpx solid rgba(79, 70, 229, 0.18);
}

.daily-task-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.daily-task-copy {
  flex: 1;
  min-width: 0;
}

.daily-task-title,
.week-headline {
  display: block;
  font-size: 31rpx;
  line-height: 1.45;
  font-weight: 750;
  color: var(--text);
}

.daily-task-reason {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--muted);
}

.daily-task-time {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--accent);
  background: rgba(79, 70, 229, 0.1);
}

.daily-task-button {
  height: 78rpx;
  margin: 24rpx 0 0;
  border-radius: 22rpx;
  border: 0;
  line-height: 78rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--accent);
}

.daily-task-button::after {
  border: 0;
}

.week-card {
  padding: 28rpx;
}

.change-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 18rpx;
}

.change-label {
  flex: none;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.change-good {
  color: #047857;
  background: #dff8ed;
}

.change-watch {
  color: #b45309;
  background: #fff1d6;
}

.change-text {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--text);
}

.tab-row,
.metric-tabs {
  display: flex;
  gap: 12rpx;
}

.tab-row {
  margin-bottom: 16rpx;
}

.tab-chip,
.metric-chip {
  padding: 12rpx 24rpx;
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--muted);
  background: var(--surface);
}

.tab-chip-active,
.metric-chip-active {
  color: #ffffff;
  border-color: var(--accent);
  background: var(--accent);
}

.metric-tabs {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.metric-chip {
  flex: 1;
  padding: 10rpx 4rpx;
  text-align: center;
  font-size: 21rpx;
}

.growth-list {
  overflow: hidden;
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}

.growth-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  border-bottom: 2rpx solid var(--border);
}

.growth-item:last-child {
  border-bottom: 0;
}

.growth-item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}

.growth-item-evidence {
  display: block;
  margin-top: 7rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

.status-pill {
  flex: none;
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #1d4ed8;
  background: #e8efff;
}

.status-repeat {
  color: #b45309;
  background: #fff1d6;
}

.mastery-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mastery-chip {
  padding: 12rpx 18rpx;
  border: 2rpx solid #bdebd6;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #047857;
  background: #effcf6;
}

.empty-strip {
  padding: 24rpx 26rpx;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.64);
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-card {
  padding: 24rpx 28rpx 20rpx;
}

.trend-empty {
  padding: 34rpx 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.sparkline {
  position: relative;
  height: 140rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.sparkline-area {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  background: linear-gradient(180deg, rgba(79, 70, 229, 0.14), rgba(79, 70, 229, 0.02));
}

.sparkline-segment {
  position: absolute;
  height: 5rpx;
  border-radius: 999rpx;
  background: var(--accent);
  transform-origin: left center;
}

.sparkline-point {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  margin-top: -6rpx;
  border-radius: 50%;
  background: var(--accent);
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 20rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  flex: 1;
  color: #ffffff;
  background: var(--accent);
  box-shadow: 0 16rpx 36rpx rgba(79, 70, 229, 0.28);
}

.btn-secondary {
  flex: 1;
  color: var(--text);
  background: var(--surface);
  border: 2rpx solid var(--border);
}

.btn-ghost {
  flex: 0.7;
  color: var(--muted);
  background: var(--surface);
  border: 2rpx solid var(--border);
}

.footer-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border);
  background: rgba(255, 255, 255, 0.72);
}

.footer-note-text {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--muted);
}

.state-box {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border);
  background: var(--surface);
}

.state-box-soft {
  background: #fffaf0;
}

.state-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
}

.state-text {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--muted);
}

.auth-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0 0 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}

.auth-bar-on {
  border-color: rgba(16, 185, 129, 0.4);
  background: linear-gradient(135deg, #f0fdf7 0%, #ffffff 100%);
}

.auth-bar-icon {
  font-size: 40rpx;
  line-height: 1;
}

.auth-bar-text {
  flex: 1;
  min-width: 0;
}

.auth-bar-title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
}

.auth-bar-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.auth-bar-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #07c160;
  color: #fff;
  font-size: 24rpx;
  border: none;
}

.auth-bar-btn::after {
  border: none;
}

.auth-bar-enter {
  font-size: 24rpx;
  color: var(--muted);
}
