<view class="dashboard-page">
  <scroll-view scroll-y="true" class="dashboard-scroll">
    <view class="dashboard-shell">
      <view class="dashboard-topbar">
        <view>
          <text class="dashboard-title">你好，同学</text>
          <text class="dashboard-subtitle">{{greetingText}}</text>
        </view>
        <view class="countdown-box">
          <text class="countdown-num num">{{daysToGaokao}}</text>
          <text class="countdown-unit">距高考(天)</text>
        </view>
      </view>

      <view class="auth-bar {{authState.loggedIn ? 'auth-bar-on' : ''}}" bindtap="goAuth">
        <view class="auth-bar-icon">{{authState.loggedIn ? '✅' : '🔓'}}</view>
        <view class="auth-bar-text">
          <text class="auth-bar-title">{{authState.loggedIn ? '已登录' : '未登录'}}</text>
          <text class="auth-bar-sub">{{authState.loggedIn ? authState.openIdMask : '点击微信登录，同步记录与会员'}}</text>
        </view>
        <button wx:if="{{!authState.loggedIn}}" class="auth-bar-btn" catchtap="handleHomeLogin" loading="{{authState.logging}}">微信登录</button>
        <text wx:else class="auth-bar-enter">管理 ›</text>
      </view>

      <text class="section-title section-title-first">今日提升任务</text>
      <panel-card extraClass="daily-task-card">
        <view class="daily-task-top">
          <view class="daily-task-copy">
            <text class="daily-task-title">{{dailyTask.title}}</text>
            <text class="daily-task-reason">{{dailyTask.reason}}</text>
          </view>
          <text class="daily-task-time">约 {{dailyTask.minutes}} 分钟</text>
        </view>
        <button class="daily-task-button" bindtap="startDailyTask">开始今日任务</button>
      </panel-card>

      <text class="section-title">本周进步</text>
      <panel-card extraClass="week-card">
        <text class="week-headline">{{weekSummary.headline || '完成两次同类型正式批改后，就能看到本周变化'}}</text>
        <view wx:if="{{weekSummary.improved.length}}" class="change-row">
          <text class="change-label change-good">进步</text>
          <text class="change-text">{{weekSummary.improvedText}}</text>
        </view>
        <view wx:if="{{weekSummary.declined.length}}" class="change-row">
          <text class="change-label change-watch">留意</text>
          <text class="change-text">{{weekSummary.declinedText}}</text>
        </view>
      </panel-card>

      <text class="section-title">能力趋势</text>
      <view class="tab-row">
        <view wx:for="{{growthEssayTypeTabs}}" wx:key="code"
          class="tab-chip {{growthEssayType === item.code ? 'tab-chip-active' : ''}}"
          data-type="{{item.code}}" bindtap="chooseGrowthEssayType">{{item.label}}</view>
      </view>
      <panel-card extraClass="trend-card">
        <view class="metric-tabs">
          <view wx:for="{{growthMetricTabs}}" wx:key="code"
            class="metric-chip {{growthMetric === item.code ? 'metric-chip-active' : ''}}"
            data-metric="{{item.code}}" bindtap="chooseGrowthMetric">{{item.label}}</view>
        </view>
        <view wx:if="{{growthTrendPoints.length}}" class="sparkline">
          <view class="sparkline-area"></view>
          <view wx:for="{{growthTrendSegments}}" wx:key="index" class="sparkline-segment" style="{{item.style}}"></view>
          <view wx:for="{{growthTrendPoints}}" wx:key="index" class="sparkline-point" style="{{item.style}}"></view>
        </view>
        <view wx:else class="trend-empty">{{growthEmptyText}}</view>
      </panel-card>

      <text class="section-title">重复出现</text>
      <view wx:if="{{growthErrors.length}}" class="growth-list">
        <view wx:for="{{growthErrors}}" wx:key="code" class="growth-item">
          <view>
            <text class="growth-item-title">{{item.label}}</text>
            <text class="growth-item-evidence">{{item.evidence || '建议放进今天的专项练习'}}</text>
          </view>
          <text class="status-pill {{item.status === 'REPEATED' ? 'status-repeat' : ''}}">
            {{item.status === 'REPEATED' ? '重复出现' : '新发现'}}
          </text>
        </view>
      </view>
      <view wx:else class="empty-strip">暂未发现重复弱项，继续保持。</view>

      <text class="section-title">已掌握</text>
      <view wx:if="{{growthMasteryItems.length}}" class="mastery-wrap">
        <text wx:for="{{growthMasteryItems}}" wx:key="code" class="mastery-chip">✓ {{item.label}}</text>
      </view>
      <view wx:else class="empty-strip">连续几篇不再出现的错误，会自动收进这里。</view>

      <view class="action-row">
        <button class="btn btn-primary" bindtap="goWrite">写作文</button>
        <button class="btn btn-secondary" bindtap="goCoach">AI 陪练</button>
        <button class="btn btn-ghost" bindtap="goReport">报告</button>
      </view>

      <view wx:if="{{footerHint}}" class="footer-note">
        <text class="footer-note-text">{{footerHint}}</text>
      </view>

      <view wx:if="{{loading}}" class="state-box">
        <text class="state-title">首页数据加载中</text>
        <text class="state-text">正在同步学习档案和最近批改记录。</text>
      </view>

      <view wx:if="{{loadError}}" class="state-box state-box-soft">
        <text class="state-title">已降级展示</text>
        <text class="state-text">{{loadError}}</text>
      </view>
    </view>
  </scroll-view>
</view>
