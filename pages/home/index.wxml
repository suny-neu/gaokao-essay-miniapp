<view class="dashboard-page">
  <scroll-view scroll-y="true" class="dashboard-scroll">
    <view class="dashboard-shell" style="padding-top: {{homeTopInset}}px;">
      <view class="dashboard-header">
        <view class="header-copy">
          <text class="dashboard-title">今天练什么</text>
          <text class="dashboard-subtitle page-purpose">每天 10 分钟，稳步提升英语写作</text>
        </view>
        <view class="countdown-card">
          <text class="countdown-value num">{{daysToGaokao}}</text>
          <text class="countdown-label">距高考</text>
        </view>
      </view>

      <panel-card extraClass="task-card">
        <view class="task-head">
          <view class="task-eyebrow">
            <view class="target-icon"><view class="target-dot"></view></view>
            <text>今日提升任务</text>
          </view>
        </view>
        <view class="task-body">
          <view class="task-copy">
            <text class="task-title">{{dailyTask.title}}</text>
            <text class="task-reason">{{dailyTask.reason}}</text>
          </view>
          <view class="task-visual" aria-hidden="true">
            <view class="paper-sheet paper-back"></view>
            <view class="paper-sheet paper-front">
              <view class="paper-check"></view>
              <view class="paper-line line-long"></view>
              <view class="paper-line line-mid"></view>
              <view class="paper-line line-short"></view>
            </view>
            <view class="task-pen"><view class="pen-clip"></view></view>
          </view>
        </view>
        <view class="task-duration">
          <view class="clock-icon"><view></view></view>
          <text>约 {{dailyTask.minutes || 10}} 分钟</text>
        </view>
        <view class="initial-action">
          <button class="primary-btn task-primary" disabled="{{!dailyQuotaActionEnabled}}" bindtap="handleDailyPrimaryAction">{{dailyActionText}}</button>
        </view>
        <text class="task-quota">{{dailyQuotaText}}</text>
      </panel-card>

      <view class="metric-grid">
        <panel-card extraClass="summary-metric-card">
          <view class="metric-card-head">
            <text class="metric-card-label">本周进步</text>
            <view class="trend-mark"><view></view><view></view><view></view></view>
          </view>
          <text class="metric-card-value metric-value-{{weeklyMetric.tone}} num">{{weeklyMetric.value}}</text>
          <text class="metric-status metric-status-{{weeklyMetric.tone}}">{{weeklyMetric.helper}}</text>
        </panel-card>

        <panel-card extraClass="summary-metric-card">
          <view class="metric-card-head">
            <text class="metric-card-label">连续学习</text>
            <view class="streak-ring"><view class="streak-flame"></view></view>
          </view>
          <view class="metric-value-row">
            <text class="metric-card-value num">{{streakMetric.value}}</text>
            <text class="metric-card-unit">{{streakMetric.unit}}</text>
          </view>
          <text class="metric-helper">{{streakMetric.helper}}</text>
        </panel-card>
      </view>

      <panel-card extraClass="trend-dashboard-card">
        <view class="card-heading-row">
          <text class="dashboard-card-title">能力趋势</text>
          <view class="type-tabs">
            <view wx:for="{{growthEssayTypeTabs}}" wx:key="code"
              class="type-tab {{growthEssayType === item.code ? 'type-tab-active' : ''}}"
              data-type="{{item.code}}" bindtap="chooseGrowthEssayType">{{item.label}}</view>
          </view>
        </view>

        <view class="dashboard-chart">
          <view class="chart-grid-line chart-grid-top"></view>
          <view class="chart-grid-line chart-grid-middle"></view>
          <view class="chart-grid-line chart-grid-bottom"></view>
          <view class="chart-area"></view>
          <view wx:for="{{growthTrendSegments}}" wx:key="index" class="chart-segment" style="{{item.style}}"></view>
          <view wx:for="{{growthTrendPoints}}" wx:key="index" class="chart-point" style="{{item.style}}"></view>
          <view wx:if="{{!growthTrendPoints.length}}" class="chart-empty-overlay">
            <text>{{growthEmptyText}}</text>
            <button class="chart-empty-action" bindtap="startDailyTask">开始今天练习</button>
          </view>
        </view>
        <view wx:if="{{growthTrendPoints.length}}" class="chart-date-row">
          <text wx:for="{{growthTrendPoints}}" wx:key="index">{{item.dateLabel}}</text>
        </view>

        <view class="capability-row">
          <view wx:for="{{capabilityMetrics}}" wx:key="label" class="capability-item">
            <text class="capability-label">{{item.label}}</text>
            <text class="capability-value num">{{item.value}}</text>
          </view>
        </view>
      </panel-card>

      <panel-card extraClass="priority-card">
        <text class="dashboard-card-title">需要重点练习</text>
        <view class="priority-list">
          <view wx:for="{{priorityItems}}" wx:key="code" class="priority-item" bindtap="startDailyTask">
            <view class="priority-symbol priority-symbol-{{item.tone}}"><view></view></view>
            <view class="priority-copy">
              <text class="priority-title">{{item.label}}</text>
            </view>
            <text wx:if="{{item.tone === 'attention'}}" class="priority-badge badge-attention">{{item.badge}}</text>
            <text wx:else class="priority-badge badge-{{item.tone}}">{{item.badge}}</text>
            <text class="priority-arrow">›</text>
          </view>
        </view>
        <view wx:if="{{growthMasteryItems.length}}" class="mastery-strip">
          <text class="mastery-label">已掌握</text>
          <text class="mastery-text">{{growthMasteryItems[0].label}}</text>
        </view>
      </panel-card>

      <view class="quick-nav">
        <button class="quick-nav-item" bindtap="goWrite">
          <view class="quick-icon write-icon"><view></view></view>
          <text>写作文</text>
        </button>
        <button class="quick-nav-item" bindtap="goCoach">
          <view class="quick-icon code-icon"><text>AI</text></view>
          <text>AI 陪练</text>
        </button>
        <button class="quick-nav-item" bindtap="goReport">
          <view class="quick-icon report-icon"><view></view><view></view><view></view></view>
          <text>看报告</text>
        </button>
      </view>

    </view>
  </scroll-view>

  <view class="bottom-nav">
    <button class="bottom-nav-item bottom-nav-active">
      <view class="home-nav-icon"><view></view></view>
      <text>首页</text>
    </button>
    <button class="bottom-nav-item" bindtap="goHistory">
      <view class="history-nav-icon"><view></view></view>
      <text>历史</text>
    </button>
    <button class="bottom-nav-item" bindtap="goAuth">
      <view class="profile-nav-icon"><view></view></view>
      <text>我的</text>
    </button>
  </view>
</view>
